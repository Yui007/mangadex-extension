{
  "manifest_version": 3,
  "name": "MangaDex Downloader",
  "version": "2.0",
  "description": "Downloads chapters from MangaDex via the official API.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "offscreen",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://mangadex.org/*",
    "https://api.mangadex.org/*",
    "https://uploads.mangadex.org/*",
    "https://*.mangadex.network/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
